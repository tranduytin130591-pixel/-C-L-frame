{
  "name": "photobooth-frame-puncher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron:dev": "cross-env ELECTRON_DEV_URL=http://localhost:3000 electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "productName": "Photobooth Frame Puncher",
  "description": "Đục lỗ trong suốt cho frame photobooth và xuất PDF/PNG overlay",
  "author": "tranduytin",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.thezone.photobooth-frame-puncher",
    "productName": "Photobooth Frame Puncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Photobooth Frame Puncher",
      "artifactName": "PhotoboothFramePuncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PhotoboothFramePuncher-Portable-${version}.${ext}"
    }
  }
}
